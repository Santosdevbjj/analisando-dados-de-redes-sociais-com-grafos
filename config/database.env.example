# Configurações de Conexão com o Neo4j AuraDB Free
# Copie este arquivo para 'database.env' ou '.env' e preencha as credenciais.
# NUNCA insira as credenciais reais neste arquivo .example!

NEO4J_URI=neo4j+s://<YOUR_INSTANCE_ID>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<SET_LOCALLY>
NEO4J_DATABASE=neo4j

# Parâmetros da Pipeline de Dados
SAMPLE_SIZE=1000
RANDOM_SEED=42
